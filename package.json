{
  "name": "stylenest",
  "private": true,
  "version": "1.0.0",
  "workspaces": ["client", "server"],
  "scripts": {
    "install:all": "npm install",
    "dev": "concurrently \"npm run dev --workspace server\" \"npm run dev --workspace client\"",
    "build": "npm run build --workspace client",
    "seed:admin": "npm run seed:admin --workspace server",
    "seed:data": "npm run seed:data --workspace server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
